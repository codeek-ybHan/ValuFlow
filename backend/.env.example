DART_API_KEY=
# PostgreSQL (선택). 예: postgresql://valuflow:valuflow@localhost:5432/valuflow
DATABASE_URL=
# serverless: pool 을 작게 제한 (기본 2 / overflow 0). 외부 pooler(pgbouncer 등)를 쓰면 DB_POOL=null
# DB_POOL_SIZE=2
# DB_MAX_OVERFLOW=0
# DB_POOL=queue
# AI Analyst (LLM Gateway). 서버 환경변수로만 설정한다 (절대 VITE_ 접두사로 두지 않는다)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# AI_STATE_SECRET=        # 대화 상태 서명용. 비우면 OPENAI_API_KEY 에서 파생
# AI_MAX_TOOL_CALLS=5
# 공시 RAG (embedding 도 backend 에서만 호출)
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# RETRIEVAL_MIN_SCORE=0.3
# Reranker: auto(fastembed 가 설치되어 있으면 로컬 cross-encoder) | cross-encoder | cohere | none
# RERANKER=auto
# RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual   # CC-BY-NC 라이선스: 상업 이용이면 BAAI/bge-reranker-base(MIT) 등으로 교체
# RERANKER_API_KEY=         # RERANKER=cohere 일 때만 (예전 이름 COHERE_API_KEY 도 읽는다). 없으면 reranking 만 꺼지고 Hybrid 로 동작
# RERANK_CANDIDATES=15
# RERANK_MIN_SCORE=          # 비워 두면 점수로 걸러내지 않는다
# MAX_UPLOAD_MB=20           # 사용자 PDF 업로드 한도
# 외부 데이터 Tool (시세 · WACC 근거 · 비교기업 · 뉴스; API Key 불필요)
# EXTERNAL_DATA=true
# MARKET_TTL_SECONDS=300
# FUNDAMENTALS_TTL_SECONDS=86400
# RATE_TTL_SECONDS=86400
# NEWS_TTL_SECONDS=900
# 외부 provider 선택 + credential (모두 backend 환경변수에만; VITE_ 접두사 금지). 기본 provider(yahoo · google)는 Key 가 필요 없다.
# Key 가 필요한 provider 를 골랐는데 Key 가 없으면 그 Tool 만 unavailable 이다 (AI Analyst 전체는 계속 동작).
# MARKET_DATA_PROVIDER=yahoo
# MARKET_DATA_API_KEY=
# NEWS_PROVIDER=google
# NEWS_API_KEY=
# AI_AGENT_MAX_TOOL_CALLS=10   # Agent workflow 의 Tool 호출 상한 (일반 질문은 AI_MAX_TOOL_CALLS=5)
